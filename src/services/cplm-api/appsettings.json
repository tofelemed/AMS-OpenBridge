{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CplmDb": "Host=postgres;Port=5432;Database=traverse_cplm;Username=ams_user;Password=supersecurepassword123"
  },
  "Cpm": {
