# Auth service configuration. Copy to .env and fill in real values.

# --- Server ---
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# --- Database (traverse_auth in the shared Postgres instance) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traverse_auth
DB_USER=postgres
DB_PASSWORD=
DB_ADMIN_DB=postgres

# --- JWT / RS256 signing ---
# Provide ONE of the following in non-dev environments (required in production):
#   JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#   JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
# JWT_KEY_ID=  # optional stable key id (kid); derived from the key if unset
JWT_ISSUER=traverse-auth
JWT_AUDIENCE=ams-services
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Cookies (refresh token) ---
# COOKIE_SECURE defaults to true in production, false otherwise.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_PATH=/api/auth

# --- CORS: comma-separated allowed origins (credentialed, so no wildcard) ---
CORS_ORIGIN=http://localhost:5174,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Bootstrap admin (used by `npm run seed:admin`) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
