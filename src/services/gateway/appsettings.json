{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "_comment": "ExposeSwagger gates the /swagger route (GW-01: not publicly reachable in production). Tls:CertPath enables HTTPS on 8443; empty = HTTP only (lab). ExternalFeedUrl replaces the LAN IP that was hardcoded in nginx.conf.",
    "ExposeSwagger": false,
    "Tls": {
      "CertPath": "",
      "CertPassword": ""
    }
  },

  "Redis": {
    "Host": "redis",
    "Port": 6379
  },

  "BodyLimits": {
    "_comment": "Per-route request-body caps (Plan 04 item 5): ACK 4 KB, display JSON 2 MB, default 256 KB. Oversize -> 413 before the proxy; chunked uploads are cut off by the per-request Kestrel bound.",
    "Enabled": true,
    "AckBytes": 4096,
    "DisplayBytes": 2097152,
    "DefaultBytes": 262144
  },

  "RateLimiting": {
    "_comment": "GW-03. Fixed 60s windows on Redis (rl:{class}:{client}:{windowStart}). login/global are per-IP; the rest key on the token's sub. login+mutation fail CLOSED on Redis outage, reads fail OPEN (operators never lose alarm visibility to a dead cache).",
    "Enabled": true,
    "WindowSeconds": 60,
    "LoginPerMinutePerIp": 10,
    "SnapshotPerMinute": 30,
    "HistorianPerMinute": 120,
    "MutationPerMinute": 120,
    "ReadPerMinute": 600,
    "GlobalPerMinutePerIp": 2000
  },

  "Auth": {
    "_comment": "Edge-only JWT validation (Plan 04 §2). ServiceKey authenticates the revocation poll to auth-service's internal endpoint; without it revocation polling is disabled (TTL-only).",
    "JwksUrl": "http://auth-service:3002/api/auth/.well-known/jwks.json",
    "AuthServiceUrl": "http://auth-service:3002",
    "Issuer": "traverse-auth",
    "Audience": "ams-services",
    "ServiceKey": "",
    "RevocationPollSeconds": 5
  },

  "ReverseProxy": {
    "_comment": "Route map mirrors src/frontend-ob/nginx.conf 1:1 — review them side by side. Order: lower wins; specific prefixes at 0, the /api catch-all at 100 (nginx longest-prefix semantics). AuthorizationPolicy: 'default' = authenticated at the edge; 'anonymous' = public (auth-service's own routes, and /mqtt-ws until Plan 04 item 6 closes the MQTT plane).",

    "Routes": {
      "api-auth": {
        "ClusterId": "auth-service",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**rest}" }
      },

      "api-cpm": {
        "ClusterId": "cplm-api",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/cpm/{**rest}" }
      },
      "api-cpm-bare": {
        "ClusterId": "cplm-api",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/cpm" }
      },

      "api-displays": {
        "ClusterId": "display-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/displays/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "api-displays-bare": {
        "ClusterId": "display-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/displays" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      "api-bindings": {
        "ClusterId": "binding-resolver",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/bindings/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/bindings" } ]
      },
      "api-bindings-bare": {
        "ClusterId": "binding-resolver",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/bindings" },
        "Transforms": [ { "PathRemovePrefix": "/api/bindings" } ]
      },

      "api-assets": {
        "ClusterId": "asset-model",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/assets/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "api-assets-bare": {
        "ClusterId": "asset-model",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/assets" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "api-aliases": {
        "ClusterId": "asset-model",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/aliases/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      "api-templates": {
        "ClusterId": "template-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/templates/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "api-templates-bare": {
        "ClusterId": "template-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/templates" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      "api-analyses": {
        "ClusterId": "analysis-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/analyses/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "api-analyses-bare": {
        "ClusterId": "analysis-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/analyses" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      "api-audit": {
        "ClusterId": "audit-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/audit/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/audit" },
          { "PathPrefix": "/api/v1/audit" }
        ]
      },
      "api-audit-bare": {
        "ClusterId": "audit-service",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/audit" },
        "Transforms": [
          { "PathRemovePrefix": "/api/audit" },
          { "PathPrefix": "/api/v1/audit" }
        ]
      },

      "api-hist": {
        "ClusterId": "historian-bff",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/hist/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api/hist" } ]
      },

      "api-catchall": {
        "_comment": "Everything else under /api goes to ams-api, same as the nginx /api/ location.",
        "ClusterId": "ams-api",
        "Order": 100,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{**rest}" }
      },

      "external-feed": {
        "_comment": "nginx hardcoded http://192.168.1.51:8010/api/ — now config-driven via the external-feed cluster address. No consumer exists in src/ (decommission candidate, Plan 04 item 7); auth required meanwhile.",
        "ClusterId": "external-feed",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/external-api/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/external-api" },
          { "PathPrefix": "/api" }
        ]
      },

      "hubs": {
        "_comment": "SignalR (WebSockets/SSE). Token arrives as ?access_token= per the SignalR contract; validated at the edge like any bearer.",
        "ClusterId": "ams-api-ws",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/{**rest}" }
      },

      "mqtt-ws": {
        "_comment": "Anonymous until Plan 04 item 6 turns on EMQX JWT auth + the frontend presents the token on connect — flip to 'default' in the same change.",
        "ClusterId": "emqx-ws",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/mqtt-ws" },
        "Transforms": [
          { "PathRemovePrefix": "/mqtt-ws" },
          { "PathPrefix": "/mqtt" }
        ]
      },
      "mqtt-ws-sub": {
        "ClusterId": "emqx-ws",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/mqtt-ws/{**rest}" },
        "Transforms": [
          { "PathRemovePrefix": "/mqtt-ws" },
          { "PathPrefix": "/mqtt" }
        ]
      },

      "health-passthrough": {
        "_comment": "Parity with nginx: /health proxies to ams-api (public liveness). The gateway's own liveness is /gw/health.",
        "ClusterId": "ams-api",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/health" }
      },

      "swagger": {
        "_comment": "Blocked by middleware unless Gateway:ExposeSwagger=true (GW-01); anonymous when exposed (non-prod only).",
        "ClusterId": "ams-api",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/{**rest}" }
      },
      "swagger-bare": {
        "ClusterId": "ams-api",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger" }
      }
    },

    "_clusterComment": "Every cluster carries a passive-health circuit breaker (TransportFailureRate): TRANSPORT failures only — connect refused/timeout — mark the destination unhealthy and requests fail fast with 503 until the reactivation window (60s — floored by the policy's failure-rate detection window). An upstream 5xx RESPONSE is a healthy transport and never trips it, so a service having a bad day is not cut off. ConnectTimeout (5s, Gateway:ConnectTimeoutSeconds) bounds the dial.",
    "Clusters": {
      "ams-api": {
        "Destinations": { "d1": { "Address": "http://ams-api:8000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "ams-api-ws": {
        "Destinations": { "d1": { "Address": "http://ams-api:8000" } },
        "HttpRequest": { "ActivityTimeout": "1.00:00:00" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "auth-service": {
        "Destinations": { "d1": { "Address": "http://auth-service:3002" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "asset-model": {
        "Destinations": { "d1": { "Address": "http://asset-model:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "display-service": {
        "Destinations": { "d1": { "Address": "http://display-service:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "binding-resolver": {
        "Destinations": { "d1": { "Address": "http://binding-resolver:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "template-service": {
        "Destinations": { "d1": { "Address": "http://template-service:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "analysis-service": {
        "Destinations": { "d1": { "Address": "http://analysis-service:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "cplm-api": {
        "Destinations": { "d1": { "Address": "http://cplm-api:5000" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "audit-service": {
        "Destinations": { "d1": { "Address": "http://audit-service:8080" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "historian-bff": {
        "Destinations": { "d1": { "Address": "http://historian-bff:8090" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "emqx-ws": {
        "Destinations": { "d1": { "Address": "http://emqx:8083" } },
        "HttpRequest": { "ActivityTimeout": "1.00:00:00" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      },
      "external-feed": {
        "Destinations": { "d1": { "Address": "http://192.168.1.51:8010" } },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:01:00" }, "AvailableDestinationsPolicy": "HealthyAndUnknown" },
        "Metadata": { "TransportFailureRateHealthPolicy.RateLimit": "0.5" }
      }
    }
  }
}
