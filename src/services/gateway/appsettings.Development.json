{
  "_comment": "Host-run gateway against the docker-published service ports (for local dev/testing). Docker deployment uses the in-network addresses from appsettings.json.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Debug"
    }
  },
  "Auth": {
    "JwksUrl": "http://127.0.0.1:3002/api/auth/.well-known/jwks.json",
    "AuthServiceUrl": "http://127.0.0.1:3002"
  },
  "Redis": {
    "Host": "127.0.0.1",
    "Port": 6380
  },
  "ReverseProxy": {
    "Routes": {
      "dev-echo": {
        "_comment": "DEV ONLY — header-echo upstream to observe X-Auth-* injection and spoof stripping in tests. Not present in the production route map.",
        "ClusterId": "dev-echo",
        "Order": 0,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/echo/{**rest}" }
      }
    },
    "Clusters": {
      "dev-echo":         { "Destinations": { "d1": { "Address": "http://127.0.0.1:9999" } } },
      "ams-api":          { "Destinations": { "d1": { "Address": "http://127.0.0.1:8000" } } },
      "ams-api-ws":       { "Destinations": { "d1": { "Address": "http://127.0.0.1:8000" } } },
      "auth-service":     { "Destinations": { "d1": { "Address": "http://127.0.0.1:3002" } } },
      "asset-model":      { "Destinations": { "d1": { "Address": "http://127.0.0.1:5001" } } },
      "display-service":  { "Destinations": { "d1": { "Address": "http://127.0.0.1:5003" } } },
      "binding-resolver": { "Destinations": { "d1": { "Address": "http://127.0.0.1:5002" } } },
      "template-service": { "Destinations": { "d1": { "Address": "http://127.0.0.1:5004" } } },
      "analysis-service": { "Destinations": { "d1": { "Address": "http://127.0.0.1:5005" } } },
      "cplm-api":         { "Destinations": { "d1": { "Address": "http://127.0.0.1:5006" } } },
      "audit-service":    { "Destinations": { "d1": { "Address": "http://127.0.0.1:8095" } } },
      "historian-bff":    { "Destinations": { "d1": { "Address": "http://127.0.0.1:8090" } } },
      "emqx-ws":          { "Destinations": { "d1": { "Address": "http://127.0.0.1:8083" } } }
    }
  }
}
