# Copy to migration/.env on the VM. 01/03 refuse any CHANGE_ME left behind.
# Do not use Instrumental JWT_SECRET. deploy.sh copies AMS_DB_PASSWORD → POSTGRES_PASSWORD
# and BOOTSTRAP_ADMIN_* → AUTH_BOOTSTRAP_* when those compose names are empty.

POSTGRES_CONTAINER=instrumental-postgres
POSTGRES_HOST=instrumental-postgres
POSTGRES_USER=postgres
# Dedicated role for our DBs only. Never GRANT this onto Instrumental databases.
AMS_DB_USER=ams_user
AMS_DB_PASSWORD=CHANGE_ME

KAFKA_CONTAINER=instrumental-kafka-1
# From inside KAFKA_CONTAINER (04 uses this):
KAFKA_BOOTSTRAP_INSIDE=localhost:9092
# From AMS / Flink containers on instrumental-network (04b / compose):
KAFKA_BOOTSTRAP_INTERNAL=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC_RF=3
KAFKA_TOPIC_MIN_ISR=2

DOCKER_NETWORK=instrumental-network
# Same value on the build PC and on the VM. Overlay `name:` is also ams-cpa.
COMPOSE_PROJECT_NAME=ams-cpa

# First Admin (03-seed.sh). Password is bcrypt-hashed at apply time.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

FLINK_JOBMANAGER_CONTAINER=ams-flink-jobmanager
FLINK_JOBMANAGER_PORT=8081
FLINK_JAR_PATH=/opt/flink/usrlib/ams-flink-1.0-SNAPSHOT.jar

# HTTP — Instrumental keeps :80. Do not publish :3000 / :1883.
GATEWAY_HOST_PORT=8081
FRONTEND_HOST_PORT=8088
EMQX_DASHBOARD_HOST_PORT=18083

# Opt-in: ams-api (RawLoop → IoTDB) still expects Database=ams, which this cut does not create.
# START_AMS_API=yes

# Compose secrets (needed to parse infra/docker/docker-compose.yml even for unused lab services).
# Generate: openssl rand -hex 24
TRAVERSE_SERVICE_KEY=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
EMQX_EDGE_PASSWORD=CHANGE_ME
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
INGESTION_ENCRYPTION_KEY=CHANGE_ME
IOTDB_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Unused this cut; compose still interpolates them:
GRAFANA_PASSWORD=CHANGE_ME
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# Ops confirm on the shared Instrumental broker. Leave commented until signed off.
# Creating prefixed topics / submitting Flink does not happen without these.
# ALLOW_CREATE_PREFIXED_TOPICS=yes
# ALLOW_FLINK_SUBMIT=yes
