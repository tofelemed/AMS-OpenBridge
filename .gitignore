# =============================================================================
# Enterprise CAMS — .gitignore
# Covers: .NET 8, React/Vite, Apache Flink/Maven, Docker, OPC redistributables
# =============================================================================

# -----------------------------------------------------------------------------
# OPC Foundation redistributables (place MSI/DLLs locally; do not commit without license)
# See: third-party/opc-core-redist/README.md
# -----------------------------------------------------------------------------
third-party/opc-core-redist/x86/*.dll
third-party/opc-core-redist/installers/*.msi
third-party/opc-core-redist/installers/*.msm
third-party/opc-core-redist/installers/*.zip
third-party/opc-core-redist/extracted/
third-party/opc-core-redist/msm-extract/
third-party/opc-core-redist/install-log.txt

# -----------------------------------------------------------------------------
# Environment, secrets, and local configuration overrides
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env.local
*.local.json
appsettings.*.local.json
appsettings.Local.json
secrets/
**/secrets/
*.pfx
*.p12
*.key
*.pem
!**/*.example.pem
!**/*.example.key
user-secrets.json
**/user-secrets.json

# Docker Compose local overrides and secrets
infra/docker/.env
infra/docker/docker-compose.override.yml
infra/docker/docker-compose.*.local.yml
infra/docker/certs/*
!infra/docker/certs/.gitkeep
!infra/docker/certs/README*

# Air-gap transfer bundle (contains env.copyme secrets + docker save)
/offline-bundle/
migration/deploy/build-out/

