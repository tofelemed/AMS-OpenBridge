# AMS Environment Configuration
# Copy this to .env and fill in secure values

# ---- PostgreSQL / TimescaleDB ----
POSTGRES_PASSWORD=CHANGE_ME_USE_32_CHAR_RANDOM_STRING

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# ---- Keycloak ----
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_HOSTNAME=localhost
GRAFANA_OAUTH_SECRET=CHANGE_ME_OAUTH_SECRET

# ---- Grafana ----
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS
GRAFANA_DOMAIN=localhost

# ---- TLS ----
TLS_CERT_PASSWORD=CHANGE_ME_CERT_PASS

# ---- Seq Logging ----
# Generate with: echo "password" | argon2 salt -id -t 2 -m 15 -p 1
SEQ_ADMIN_PASSWORD_HASH=CHANGE_ME_SEQ_HASH

# ---- Kafka (Docker Desktop / Windows lab) ----
# Docker services use INTERNAL kafka:9092. Host OPC Gateway uses EXTERNAL 127.0.0.1:9093.
# Do NOT set machine-wide Kafka__BootstrapServers=localhost:9092 — it breaks the gateway.
# OPC_GATEWAY_KAFKA=127.0.0.1:9093

# ---- Optional: LDAP/AD ----
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ---- Optional: Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ams-alerts@yourcompany.com

# ---- Optional: SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Optional: Teams ----
TEAMS_WEBHOOK_URL=

# ---- Optional: AWS S3 (Flink checkpoints) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FLINK_CHECKPOINT_BUCKET=ams-flink-checkpoints

# ---- StreamPipes connectivity overlay (docker-compose.streampipes.yml) ----
SP_VERSION=0.98.0
SP_DOCKER_REGISTRY=apachestreampipes
STREAMPIPES_UI_PORT=8088
STREAMPIPES_COUCHDB_PASSWORD=CHANGE_ME_STREAMPIPES_COUCHDB

# ---- Ingest authority guard (compose preflight) ----
# QuickOPC removed from AMS.OpcGateway — gateway cannot publish raw-opc-events.
# Valid pairs:
#  1) streampipes + false   => StreamPipes sole telemetry ingest (production OPC UA)
#  2) gateway + false       => legacy label only; same as (1) for compose guard
INGEST_AUTHORITY=streampipes
OPC_GATEWAY_ENABLE_RAW_EVENT_PUBLISH=false

# ── Phase 6: Hardening & Observability ───────────────────────────────────
# EMQX Dashboard credentials (Phase 6 — used for Prometheus scrape too)
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_EMQX_DASHBOARD
# MQTT auth credentials for Sparkplug edge node (must match EMQX built-in user)
EMQX_EDGE_USER=ams_edge
EMQX_EDGE_PASSWORD=CHANGE_ME_EMQX_EDGE
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS
# ─────────────────────────────────────────────────────────────────────────

# ── Phase 5: Frontend MQTT / Historian BFF ────────────────────────────────
# MQTT over WebSocket — points at EMQX ws listener
# Dev: set to ws://localhost:8083/mqtt  (Vite proxy handles /mqtt-ws in dev)
# Prod: set to wss://your-domain/mqtt-ws
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
# Historian BFF snapshot + trend endpoints (proxied to /api/hist in dev)
VITE_SNAPSHOT_URL=/api/hist/snapshot
VITE_HIST_URL=/api/hist
# Sparkplug group / edge node identity (must match sparkplug-edge-node env)
VITE_SPARKPLUG_GROUP=ams_site1
VITE_SPARKPLUG_EDGE=ams_edge1
# ─────────────────────────────────────────────────────────────────────────

# ---- Free lab ingest (no vendor OPC license) ----
# opc-connector publishes mock alarms to alarm-* Kafka topics (started by start-ams-lab.ps1).
# For HTTP feed instead, set OpcHttpIngest.Enabled=true and FeedUrl in appsettings.Development.json.
# For lab ACK_CONFIRMED without vendor DCS, set LabAckSimulator.Enabled=true in appsettings.Development.json.
