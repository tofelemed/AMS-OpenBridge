# AMS Environment Configuration
# Copy this to .env and fill in secure values.
#
# SEC-02: docker-compose.yml no longer carries built-in credential fallbacks. Every
# secret below marked REQUIRED must be set here (or in your secret store / vault) or
# `docker compose up` aborts with "<VAR> must be set" — a missing secret fails loudly
# instead of silently booting with a known-bad default. Rotate any value that was ever
# committed before going to production.

# ---- PostgreSQL / TimescaleDB ----  (REQUIRED)
POSTGRES_PASSWORD=CHANGE_ME_USE_32_CHAR_RANDOM_STRING

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# ---- Keycloak ----
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_HOSTNAME=localhost
GRAFANA_OAUTH_SECRET=CHANGE_ME_OAUTH_SECRET

# ---- Grafana ----
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS
GRAFANA_DOMAIN=localhost

# ---- TLS ----
TLS_CERT_PASSWORD=CHANGE_ME_CERT_PASS

# ---- Seq Logging ----
# Generate with: echo "password" | argon2 salt -id -t 2 -m 15 -p 1
SEQ_ADMIN_PASSWORD_HASH=CHANGE_ME_SEQ_HASH

# ---- Kafka (Docker Desktop / Windows lab) ----
# Docker services use INTERNAL kafka:9092. Host OPC Gateway uses EXTERNAL 127.0.0.1:9093.
# Do NOT set machine-wide Kafka__BootstrapServers=localhost:9092 — it breaks the gateway.
# OPC_GATEWAY_KAFKA=127.0.0.1:9093

# ---- Optional: LDAP/AD ----
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ---- Optional: Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ams-alerts@yourcompany.com

# ---- Optional: SMS (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Optional: Teams ----
TEAMS_WEBHOOK_URL=

# ---- Optional: AWS S3 (Flink checkpoints) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FLINK_CHECKPOINT_BUCKET=ams-flink-checkpoints

# ---- StreamPipes connectivity overlay — NOT IN THIS REPO (Plan 08 item 6) ----
# docker-compose.streampipes.yml does not exist here; these variables are kept
# only as the documented contract for the site that supplies that overlay.
# Nothing in this repo's compose reads them.
SP_VERSION=0.98.0
SP_DOCKER_REGISTRY=apachestreampipes
STREAMPIPES_UI_PORT=8088
STREAMPIPES_COUCHDB_PASSWORD=CHANGE_ME_STREAMPIPES_COUCHDB

# ---- Ingest authority guard (compose preflight) ----
# QuickOPC removed from AMS.OpcGateway — gateway cannot publish raw-opc-events.
# Valid pairs:
#  1) streampipes + false   => StreamPipes sole telemetry ingest (production OPC UA)
#  2) gateway + false       => legacy label only; same as (1) for compose guard
INGEST_AUTHORITY=streampipes
OPC_GATEWAY_ENABLE_RAW_EVENT_PUBLISH=false

# ── Phase 6: Hardening & Observability ───────────────────────────────────
# EMQX Dashboard credentials (Phase 6 — used for Prometheus scrape too)
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_EMQX_DASHBOARD
# MQTT auth credentials for Sparkplug edge node (must match EMQX built-in user)
EMQX_EDGE_USER=ams_edge
EMQX_EDGE_PASSWORD=CHANGE_ME_EMQX_EDGE
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS
# ─────────────────────────────────────────────────────────────────────────

# ── Phase 5: Frontend MQTT / Historian BFF ────────────────────────────────
# MQTT over WebSocket — points at EMQX ws listener
# Dev: set to ws://localhost:8083/mqtt  (Vite proxy handles /mqtt-ws in dev)
# Prod: set to wss://your-domain/mqtt-ws
VITE_MQTT_WS_URL=ws://localhost:8083/mqtt
# Historian BFF snapshot + trend endpoints (proxied to /api/hist in dev)
VITE_SNAPSHOT_URL=/api/hist/snapshot
VITE_HIST_URL=/api/hist
# Sparkplug group / edge node identity (must match sparkplug-edge-node env)
VITE_SPARKPLUG_GROUP=ams_site1
VITE_SPARKPLUG_EDGE=ams_edge1
# ─────────────────────────────────────────────────────────────────────────

# ---- Free lab ingest (no vendor OPC license) ----
# ams-sim (docker-compose.sims.yml) publishes mock data for lab runs.
# For the HTTP feed, set OpcHttpIngest.Enabled=true and FeedUrl in appsettings.Development.json.
# For lab ACK_CONFIRMED without vendor DCS, set LabAckSimulator.Enabled=true in appsettings.Development.json.

# ---- Service-to-service auth ----  (REQUIRED)
# Traverse services (historian-bff, asset-model, binding-resolver, template-service,
# analysis-service, cplm-api, notification-service) refuse to start outside Development
# with the built-in default key, and compose no longer supplies one. Generate with:
#   openssl rand -hex 24
TRAVERSE_SERVICE_KEY=CHANGE_ME_USE_32_CHAR_RANDOM_STRING

# ---- Ingestion service (OT data-source credential encryption) ----  (REQUIRED)
# Master secret for AES-256-GCM encryption of stored MQTT broker passwords.
# Must be >= 32 characters. Generate with: openssl rand -hex 24
# WARNING: rotating it orphans every stored broker password (operators re-enter them).
INGESTION_ENCRYPTION_KEY=CHANGE_ME_USE_32_CHAR_RANDOM_STRING
# Loop-sample destination for the OT subscriber (default traverse.cpa.loop.samples.v1).
# Set to loop.samples.v1 on labs whose Kafka volume still carries the legacy
# un-prefixed topic generation (check: docker exec ams-kafka kafka-topics --list).
#INGESTION_LOOP_SAMPLES_TOPIC=traverse.cpa.loop.samples.v1
# Optional: credentials for the mosquitto-test broker (docker compose --profile mqtt-test).
# Defaults ams_ingest / ams-ingest-test — lab/E2E only, never a production broker.
#MOSQUITTO_TEST_USER=ams_ingest
#MOSQUITTO_TEST_PASSWORD=ams-ingest-test

# ---- First-run admin (auth-service bootstrap) ----  (REQUIRED)
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_EMAIL=admin@yourcompany.com
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---- IoTDB historian ----  (REQUIRED)
# The IoTDB server image ships with root/root. To move off it: create a dedicated user
# on the IoTDB server (CREATE USER / GRANT), then set both of these to that user. Until
# you do, IOTDB_USER=root with a strong password is the minimum — root/root must not ship.
IOTDB_USER=root
IOTDB_PASSWORD=CHANGE_ME_IOTDB_PASSWORD

# ---- MinIO (Flink checkpoint / savepoint store) ----  (REQUIRED)
MINIO_ROOT_USER=ams_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# ---- pgAdmin console ----  (REQUIRED)
PGADMIN_DEFAULT_EMAIL=admin@yourcompany.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ── Plan 09: HA overlay (docker-compose.ha.yml) ──
# Password for the 'replicator' role used by postgres-replica's pg_basebackup.
PG_REPLICATION_PASSWORD=CHANGE_ME_PG_REPLICATION
